# .env  —  À LA RACINE, à côté de docker-compose.yml
# Lu par docker-compose pour l'interpolation ${...}. NON VERSIONNÉ.
# Copier en .env et remplir avec des valeurs LOCALES.

# ── Mots de passe PostgreSQL ──
# Superutilisateur : init du conteneur + healthcheck
POSTGRES_PASSWORD=
# Compte sensolidaire_app (runtime API) — droits lignes uniquement
DB_APP_PASSWORD=
# Compte sensolidaire_owner (migrations Prisma) — droits de structure
DB_OWNER_PASSWORD=

# ── Secrets JWT ── (2 valeurs distinctes : openssl rand -base64 48)
JWT_SECRET=
JWT_REFRESH_SECRET=
