generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// MISSION DETAILLEE
// ─────────────────────────────────────────

model Mission {
  id                Int              @id @default(autoincrement())
  title             String
  country           String
  slug              String           @unique
  description       String?
  volunteer_role    String?
  programme         String?
  included          String?
  not_include       String?
  admin_info        String?
  ministry_url      String?
  health_info       String?
  helloasso_url     String?
  is_active         Boolean          @default(true)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  type              String           @default("volontariat_individuel")
  short_description String
  image_url         String?
  image_alt         String?
  how_to_go         String?
  age_min           Int?      // Service Civique — âge minimum requis
  age_max           Int?      // Service Civique — âge maximum requis
  duration_label    String?   // Service Civique — durée en texte libre (ex: "6 à 12 mois")
  role_france       String?   // Service Civique — rôle colonne 1 (mission en France)
  role_etranger     String?   // Service Civique — rôle colonne 2 (mission à l'étranger)
  candidater_url    String?   // Service Civique — lien bouton Candidater
  locations         Location[]
  pricing           MissionPricing[]
  testimonials      Testimonial[]
  missionReports    MissionReport[] 
}

// ─────────────────────────────────────────
// MISSION / PRIX ET DUREE
// ─────────────────────────────────────────

model MissionPricing {
  id             Int      @id @default(autoincrement())
  mission_id     Int
  duration_label String
  price          Decimal
  display_order  Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  mission        Mission  @relation(fields: [mission_id], references: [id])
}

// ─────────────────────────────────────────
// LIEUX DE MISSIONS
// ─────────────────────────────────────────

model Location {
  id              Int         @id @default(autoincrement())
  slug            String      @unique
  name            String
  country         String
  description     String
  image_url       String?
  map_url         String?
  website_url     String?
  is_active       Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  missions        Mission[]           // ← remplace mission_id + mission
  delegation_id   Int?
  delegation      Delegation? @relation(fields: [delegation_id], references: [id])
}

// ─────────────────────────────────────────
// TEMOIGNAGES COURTS
// ─────────────────────────────────────────

model Testimonial {
  id            Int      @id @default(autoincrement())
  mission_id    Int?
  author_name   String
  content       String
  avatar_url    String?  // photo du volontaire
  annee         Int?     // année de la mission
  status        String   @default("pending")
  show_homepage Boolean  @default(false)
  consent_given Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  mission       Mission? @relation(fields: [mission_id], references: [id])
}

// ─────────────────────────────────────────
// RAPPORT DE MISSIONS
// ─────────────────────────────────────────

model MissionReport {
  id          Int      @id @default(autoincrement())
  auteur      String
  destination String?  // kenya, senegal, sri-lanka, perou, sumatra
  type        String   // individuel, service_civique, groupe_jeune, conge_solidaire
  annee       Int
  pdf_url     String
  mission_id  Int?
  mission     Mission? @relation(fields: [mission_id], references: [id])
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

// ─────────────────────────────────────────
// ADMINISTRATEUR
// ─────────────────────────────────────────

model Admin {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password_hash      String
  role               String   @default("admin")
  refresh_token_hash String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

// ─────────────────────────────────────────
// TABLE MEDIA 
// ─────────────────────────────────────────

model Media {
  id            Int      @id @default(autoincrement())
  entity_type   String
  entity_id     Int
  file_url      String
  file_type     String
  label         String?  // optionnel — utilisé pour les liens externes
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

// ─────────────────────────────────────────
// ACTIONS SUR LE TERRAIN DETAILLEE
// ─────────────────────────────────────────

model FieldAction {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String   // court — utilisé comme H2 sur la page détail
  content     String   // texte long — paragraphes séparés par \n\n
  countries   FieldActionCountry[]
  image_url   String?  // image principale
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  tags        FieldActionTag[]
  odds        FieldActionODD[]
}

// ─────────────────────────────────────────
// TAGS LIE A UNE ACTION SUR LE TERRAIN
// ─────────────────────────────────────────

model FieldActionTag {
  id            Int         @id @default(autoincrement())
  field_action  FieldAction @relation(fields: [action_id], references: [id])
  action_id     Int
  tag           String      // Environnement, Biodiversité, Agriculture...
}

// ─────────────────────────────────────────
//ODD LIE A UNE ACTION SUR LE TERRAIN
// ─────────────────────────────────────────

model FieldActionODD {
  id            Int         @id @default(autoincrement())
  field_action  FieldAction @relation(fields: [action_id], references: [id])
  action_id     Int
  odd_number    Int         // 1 à 17
}

// ─────────────────────────────────────────
// PAYS LIE A UNE ACTION SUR LE TERRAIN
// ─────────────────────────────────────────

model FieldActionCountry {
  id          Int         @id @default(autoincrement())
  field_action FieldAction @relation(fields: [action_id], references: [id])
  action_id   Int
  country     String      // "France", "Kenya", "Sénégal"...
}

// ─────────────────────────────────────────
// ARTICLES : MEDIAS ET ACTUALITES
// ─────────────────────────────────────────

model MediaPost {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  content      String?
  theme        String
  date         DateTime
  image_url    String?
  external_url String?
  show_homepage Boolean @default(false)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

// ─────────────────────────────────────────
// ARTICLE : EDUCATION ET SENSIBILISATION
// ─────────────────────────────────────────

model EducationItem {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  description  String
  content      String?
  type         String   // Atelier, Correspondance, Éco-École
  public       String   // primaire, college_lycee, adultes — séparés par virgule
  image_url    String?
  external_url String?  // PDF ou lien externe
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

// ─────────────────────────────────────────
// RAPPORT ACTIVITES
// ─────────────────────────────────────────

model ActivityReport {
  id         Int      @id @default(autoincrement())
  annee      Int      @unique
  url        String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// ─────────────────────────────────────────
// MEMBRES DE L'ÉQUIPE
// ─────────────────────────────────────────
model TeamMember {
  id            Int      @id @default(autoincrement())
  nom           String
  role          String
  description   String?
  avatar_url    String?
  category      String   // direction, bureau, ca, egalement
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

// ─────────────────────────────────────────
// DÉLÉGATIONS INTERNATIONALES
// ─────────────────────────────────────────

model Delegation {
  id              Int      @id @default(autoincrement())
  pays            String
  flag_code       String   // code ISO 3166-1 alpha-2 ex: KE, SN...
  image_url       String
  lieu            String
  contacts        String
  display_order   Int      @default(0)
  locations Location[]
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

// ─────────────────────────────────────────
// PARTENAIRES (LOGOS)
// ─────────────────────────────────────────
model Partner {
  id            Int      @id @default(autoincrement())
  name          String
  logo_url      String?
  website_url   String?
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}