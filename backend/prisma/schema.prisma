generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// RATTACHEMENT PAYS (tâche 172D)
// ─────────────────────────────────────────
// Sur quelle page financeurs le contenu est mis en avant (/france, /suisse, ou les deux).
// Dans le dashboard : 2 cases à cocher « France » / « Suisse » (les deux = COMMUN).
// Vide = pas encore renseigné (contenus créés avant la fonctionnalité).

enum Rattachement {
  FRANCE
  SUISSE
  COMMUN
}

// ─────────────────────────────────────────
// MISSION DETAILLEE
// ─────────────────────────────────────────

model Mission {
  id                Int              @id @default(autoincrement())
  title             String
  country           String
  country_preposition   String?   // "au"/"en"/"à"/"aux", ex: "au Kenya"
  slug              String           @unique
  description       String?
  volunteer_role    String?
  programme         String?
  included          String?
  not_include       String?
  admin_info        String?
  ministry_url      String?
  health_info       String?
  helloasso_url     String?
  is_active         Boolean          @default(true)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  type              String           @default("volontariat_individuel")
  short_description String
  photo_hero_url    String?
  photo_hero_alt    String?
  photo_section_url String?
  photo_section_alt String?
  how_to_go         String?
  age_min           String?   // Service Civique — âge minimum, texte libre (ex: "16 ans")
  age_max           String?   // Service Civique — âge maximum, texte libre (ex: "25 ans (30 en situation de handicap)")
  duration_label    String?   // Service Civique — durée en texte libre (ex: "6 à 12 mois")
  role_france       String?   // Service Civique — rôle colonne 1 (mission en France)
  role_etranger     String?   // Service Civique — rôle colonne 2 (mission à l'étranger)
  candidater_url    String?   // Service Civique — lien bouton Candidater
  info_service_civique_url   String?   // Service Civique — lien "Comprendre le Service Civique"
  competences   String?   // Service Civique — texte libre, une ligne = une puce
  locations         Location[]
  pricing           MissionPricing[]
  testimonials      Testimonial[]
  missionReports    MissionReport[] 
}

// ─────────────────────────────────────────
// MISSION / PRIX ET DUREE
// ─────────────────────────────────────────

model MissionPricing {
  id             Int      @id @default(autoincrement())
  mission_id     Int
  duration_label String
  price          Decimal
  display_order  Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  mission        Mission  @relation(fields: [mission_id], references: [id])
}

// ─────────────────────────────────────────
// LIEUX DE MISSIONS
// ─────────────────────────────────────────

model Location {
  id              Int         @id @default(autoincrement())
  slug            String      @unique
  name            String
  country         String
  description     String
  mission_ss      String?
  image_url       String?
  image_alt       String?
  map_url         String?
  website_url     String?
  is_active       Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  missions        Mission[]           // ← remplace mission_id + mission
  delegation_id   Int?
  delegation      Delegation? @relation(fields: [delegation_id], references: [id])
}

// ─────────────────────────────────────────
// TEMOIGNAGES COURTS
// ─────────────────────────────────────────

model Testimonial {
  id            Int      @id @default(autoincrement())
  mission_id    Int?
  author_name   String
  content       String
  avatar_url    String?  // photo du volontaire
  annee         Int?     // année de la mission
  mois          Int?     // mois de la mission (1-12)
  type          String?  // individuel, service_civique, groupe_jeunes, conge_solidaire
  status        String   @default("pending")
  show_homepage Boolean  @default(false)
  consent_given Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  mission       Mission? @relation(fields: [mission_id], references: [id])
}

// ─────────────────────────────────────────
// RAPPORT DE MISSIONS
// ─────────────────────────────────────────

model MissionReport {
  id          Int      @id @default(autoincrement())
  auteur      String
  destination String?  // kenya, senegal, sri-lanka, perou, sumatra
  type        String   // individuel, service_civique, groupe_jeune, conge_solidaire
  annee       Int
  pdf_url     String
  mission_id  Int?
  mission     Mission? @relation(fields: [mission_id], references: [id])
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

// ─────────────────────────────────────────
// ADMINISTRATEUR
// ─────────────────────────────────────────

model Admin {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password_hash      String
  role               String   @default("admin")
  refresh_token_hash String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

// ─────────────────────────────────────────
// TABLE MEDIA 
// ─────────────────────────────────────────

model Media {
  id            Int      @id @default(autoincrement())
  entity_type   String
  entity_id     Int
  file_url      String
  file_type     String
  label         String?  // optionnel — utilisé pour les liens externes
  display_order Int      @default(0)
  force_display Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

// ─────────────────────────────────────────
// ACTIONS SUR LE TERRAIN DETAILLEE
// ─────────────────────────────────────────

model FieldAction {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String   // court — utilisé comme H2 sur la page détail
  content     String   // texte long — paragraphes séparés par \n\n
  countries   FieldActionCountry[]
  image_url   String?  // image principale
  rattachement Rattachement? // page financeurs (≠ pays où l'action a lieu)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  tags        FieldActionTag[]
  odds        FieldActionODD[]
}

// ─────────────────────────────────────────
// TAGS LIE A UNE ACTION SUR LE TERRAIN
// ─────────────────────────────────────────

model FieldActionTag {
  id            Int         @id @default(autoincrement())
  field_action  FieldAction @relation(fields: [action_id], references: [id])
  action_id     Int
  tag           String      // Environnement, Biodiversité, Agriculture...
}

// ─────────────────────────────────────────
//ODD LIE A UNE ACTION SUR LE TERRAIN
// ─────────────────────────────────────────

model FieldActionODD {
  id            Int         @id @default(autoincrement())
  field_action  FieldAction @relation(fields: [action_id], references: [id])
  action_id     Int
  odd_number    Int         // 1 à 17
}

// ─────────────────────────────────────────
// PAYS LIE A UNE ACTION SUR LE TERRAIN
// ─────────────────────────────────────────

model FieldActionCountry {
  id          Int         @id @default(autoincrement())
  field_action FieldAction @relation(fields: [action_id], references: [id])
  action_id   Int
  country     String      // "France", "Kenya", "Sénégal"...
}

// ─────────────────────────────────────────
// ARTICLES : MEDIAS ET ACTUALITES
// ─────────────────────────────────────────

model MediaPost {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  content      String?
  theme        String
  date         DateTime
  image_url    String?
  external_url String?
  author       String?  
  source       String? 
  show_homepage Boolean @default(false)
  rattachement Rattachement? // page financeurs
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

// ─────────────────────────────────────────
// SECTION : EDUCATION ET SENSIBILISATION (tâche 172)
// ─────────────────────────────────────────
// La cliente crée, ordonne et masque les sections de la page ; la mise en page reste fixe.
// Chaque bloc ne s'affiche que s'il est rempli.
// Photos et boutons : table Media (entity_type 'education_section', file_type 'image' / 'link').
// Un bouton mène à une page, un autre site ou un document PDF importé (/uploads/documents/…).

model EducationSection {
  id            Int      @id @default(autoincrement())
  slug          String   @unique   // ancre du menu (#label-eco-ecole) : générée depuis le titre, jamais modifiée
  eyebrow       String?            // surtitre (« Programme international »)
  title         String
  content       String             // texte mis en forme par la cliente : ligne vide = paragraphe, « - » = puce
  audience      String?            // infos pratiques : public — codes séparés par des virgules (maternelle, elementaire, college, lycee, adultes)
  price_eur     String?            // infos pratiques : tarif en euros (« Gratuit », « 500 € », « Sur devis ») — page /france
  price_chf     String?            // infos pratiques : tarif en francs suisses — page /suisse (page générale : les deux)
  price_detail  String?
  rattachement  Rattachement?      // page financeurs (les cartes de la section en héritent)
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  items         EducationItem[]    // les cards (ateliers…)
}

// ─────────────────────────────────────────
// CARD : EDUCATION ET SENSIBILISATION (ateliers…)
// ─────────────────────────────────────────

model EducationItem {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  description  String
  content      String?
  type         String   // surtitre de la card (Atelier…)
  public       String   // primaire, college_lycee, adultes — séparés par virgule
  image_url    String?
  external_url String?  // fiche PDF (envoyée depuis l'ordinateur) ou lien externe
  section      EducationSection? @relation(fields: [section_id], references: [id], onDelete: SetNull)
  section_id   Int?     // section qui affiche la card ; vide si la section a été supprimée
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

// ─────────────────────────────────────────
// RAPPORT ACTIVITES
// ─────────────────────────────────────────

model ActivityReport {
  id         Int      @id @default(autoincrement())
  annee      Int      @unique
  url        String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// ─────────────────────────────────────────
// MEMBRES DE L'ÉQUIPE
// ─────────────────────────────────────────
model TeamMember {
  id            Int      @id @default(autoincrement())
  nom           String
  role          String
  description   String?
  avatar_url    String?
  category      String   // direction, bureau, ca, egalement
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

// ─────────────────────────────────────────
// DÉLÉGATIONS INTERNATIONALES
// ─────────────────────────────────────────

model Delegation {
  id              Int      @id @default(autoincrement())
  pays            String
  flag_code       String   // code ISO 3166-1 alpha-2 ex: KE, SN...
  image_url       String
  lieu            String
  contacts        String
  display_order   Int      @default(0)
  locations Location[]
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

// ─────────────────────────────────────────
// PARTENAIRES (LOGOS)
// ─────────────────────────────────────────
model Partner {
  id            Int      @id @default(autoincrement())
  name          String
  logo_url      String?
  website_url   String?
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}