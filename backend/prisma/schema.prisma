// schema.prisma
// Fichier de configuration de la base de données Prisma
// Définit la connexion à PostgreSQL et tous les modèles de données (tables)

// Configuration du générateur Prisma Client
generator client {
  provider = "prisma-client-js"
}

// Configuration de la source de données
// L'URL de connexion est gérée dans prisma.config.ts (Prisma v7)
datasource db {
  provider = "postgresql"
}