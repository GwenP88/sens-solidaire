// schema.prisma
// Fichier de configuration de la base de données Prisma
// Définit la connexion à PostgreSQL et tous les modèles de données (tables)

// Configuration du générateur Prisma Client
generator client {
  provider = "prisma-client-js"
}

// Configuration de la source de données
// L'URL de connexion est gérée dans prisma.config.ts (Prisma v7)
datasource db {
  provider = "postgresql"
}

model Mission {
  id Int @id @default(autoincrement())
  title String // texte court - NOT NULL par default
  country String // texte court - NOT NULL par default
  slug String @unique
  description String @db.Text // texte long - NOT NULL
  volunteer_role String? @db.Text // texte long - le ? = NULL autorisé
  programme String? @db.Text
  included String? @db.Text
  not_include String? @db.Text
  admin_info String? @db.Text
  ministry_url String?
  health_info String? @db.Text
  helloasso_url String?
  is_active Boolean @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}