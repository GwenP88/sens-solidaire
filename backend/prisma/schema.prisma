generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Mission {
  id                Int              @id @default(autoincrement())
  title             String
  country           String
  slug              String           @unique
  description       String?
  volunteer_role    String?
  programme         String?
  included          String?
  not_include       String?
  admin_info        String?
  ministry_url      String?
  health_info       String?
  helloasso_url     String?
  is_active         Boolean          @default(true)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  type              String           @default("faune_sauvage")
  short_description String
  image_url         String?
  how_to_go         String?
  location          Location[]
  pricing           MissionPricing[]
  testimonials      Testimonial[]
}

model MissionPricing {
  id             Int      @id @default(autoincrement())
  mission_id     Int
  duration_label String
  price          Decimal
  display_order  Int
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  mission        Mission  @relation(fields: [mission_id], references: [id])
}

model Location {
  id          Int      @id @default(autoincrement())
  mission_id  Int
  slug        String   @unique
  name        String
  country     String
  description String
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  mission     Mission  @relation(fields: [mission_id], references: [id])
}

model Testimonial {
  id            Int      @id @default(autoincrement())
  mission_id    Int?
  author_name   String
  content       String
  status        String   @default("pending")
  show_homepage Boolean  @default(false)
  consent_given Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  mission       Mission? @relation(fields: [mission_id], references: [id])
}

model Admin {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password_hash      String
  role               String   @default("admin")
  refresh_token_hash String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

model Media {
  id            Int      @id @default(autoincrement())
  entity_type   String
  entity_id     Int
  file_url      String
  file_type     String
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}
