// schema.prisma
// Fichier de configuration de la base de données Prisma
// Définit la connexion à PostgreSQL et tous les modèles de données (tables)

// Configuration du générateur Prisma Client
generator client {
  provider = "prisma-client-js"
}

// Configuration de la source de données
// L'URL de connexion est gérée dans prisma.config.ts (Prisma v7)
datasource db {
  provider = "postgresql"
}

// Table Mission
// Stocke toutes les missions de volontariat proposées par l'association
// Une mission peut avoir plusieurs tarifs (MissionPricing), plusieurs lieux (Location)
// et plusieurs témoignages (Testimonial)

model Mission {
  id Int @id @default(autoincrement())
  title String // texte court - NOT NULL par default
  country String // texte court - NOT NULL par default
  type String @default("faune_sauvage") // catégorie de mission — utilisée pour les filtres frontend
  slug String @unique
  image_url String?
  description String? @db.Text  // nullable — détail page uniquement
  short_description String @db.Text // NOT NULL — toujours requis pour les cards
  volunteer_role String? @db.Text // texte long - le ? = NULL autorisé
  programme String? @db.Text
  included String? @db.Text
  not_include String? @db.Text
  admin_info String? @db.Text
  ministry_url String?
  health_info String? @db.Text
  helloasso_url String?
  is_active Boolean @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  pricing MissionPricing[] // lien avec la table prix/durée (MissionPricing)
  location Location[] // lien avec la table des lieux (Location)
  testimonials Testimonial[] //lien avec la table Testimonials
}


// Table MissionPricing
// Stocke les tarifs associés à une mission selon la durée du séjour
// Ex : "2 semaines" → 800€ / "4 semaines" → 1400€
// Une mission peut avoir plusieurs lignes de tarif (relation 1 → N)

model MissionPricing {
  id Int @id @default(autoincrement())
  mission Mission @relation(fields: [mission_id], references: [id]) //relation avec la table Mission
  mission_id Int // clé étrangère 
  duration_label String
  price Decimal 
  display_order Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// Table Location
// Stocke tous les lieux associés aus missions
// un lieu appartient qu'à une seule mission

model Location {
  id Int @id @default(autoincrement())
  mission Mission @relation(fields: [mission_id], references: [id]) //relation avec la table Mission
  mission_id Int // clé étrangère
  slug String @unique
  name String
  country String
  description String @db.Text
  is_active Boolean @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt  
}

// Table Testimonial
// Stocke les témoignages soumis par les bénévoles
// Un témoignage peut être lié à une mission (optionnel)
// Le consentement RGPD (consent_given) doit être true pour publication
// La modération se fait via status : pending → approved ou rejected
// show_homepage ne peut être true que si status = "approved" (règle métier)

model Testimonial {
  id            Int      @id @default(autoincrement())
  mission       Mission? @relation(fields: [mission_id], references: [id])
  mission_id    Int?
  author_name   String
  content       String   @db.Text
  status        String   @default("pending")
  show_homepage Boolean  @default(false)
  consent_given Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

// Table Admin
// Stocke les comptes administrateurs de la plateforme
// Le mot de passe n'est JAMAIS stocké en clair — uniquement son hash bcrypt
// refresh_token_hash est null quand l'admin n'est pas connecté
// Il est peuplé après login et vidé après logout

model Admin {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password_hash      String
  role               String   @default("admin")
  refresh_token_hash String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

// Table Media
// Centralise TOUS les fichiers uploadés pour toutes les entités
// Architecture polymorphe : pas de clé étrangère classique
// entity_type indique quelle table est concernée (ex: "mission", "location")
// entity_id indique l'ID de l'enregistrement concerné dans cette table
// La suppression des médias liés doit être gérée manuellement dans le service
// (Prisma ne peut pas faire de cascade delete sur ce pattern)

model Media {
  id            Int      @id @default(autoincrement())
  entity_type   String
  entity_id     Int
  file_url      String
  file_type     String
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}
