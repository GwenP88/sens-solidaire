# .gitignore — backend
# Fichiers à ne jamais pousser sur GitHub

# Variables d'environnement — contient des données sensibles (mots de passe, clés secrètes)
.env

# Dépendances npm — trop lourdes, se réinstallent avec npm install
node_modules/

# Fichier généré par Prisma Client — se régénère avec npx prisma generate
node_modules/.prisma/

# Fichiers uploadés par les utilisateurs — jamais versionnés
public/uploads/*
!public/uploads/images/
!public/uploads/videos/
!public/uploads/documents/
public/uploads/images/*
!public/uploads/images/.gitkeep
public/uploads/videos/*
!public/uploads/videos/.gitkeep
public/uploads/documents/*
!public/uploads/documents/.gitkeep