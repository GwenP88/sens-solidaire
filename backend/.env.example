# ── Base de données PostgreSQL ──
# Format : postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=

# ── Environnement ──
NODE_ENV=development
PORT=3000

# ── JWT (authentification admin) ──
# Générer des chaînes aléatoires longues et distinctes, ex : openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Front (CORS) ──
FRONTEND_URL=http://localhost:5173

# ── Service d'envoi d'emails (Resend) ──
# Récupérer la clé sur https://resend.com → API Keys
RESEND_API_KEY=

# ── Compte administrateur (seed) ──
ADMIN_PASSWORD=
