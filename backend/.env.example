# ── Base de données PostgreSQL ──
# Format : postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
# Séparation des droits (voir prisma/roles.sql) — deux comptes distincts :
#   - DATABASE_URL         → compte sensolidaire_app : utilisé au RUNTIME par
#     l'API (src/config/db.js). Droits LIGNES uniquement (SELECT/INSERT/
#     UPDATE/DELETE), aucun droit de structure.
#   - MIGRATE_DATABASE_URL → compte sensolidaire_owner : utilisé UNIQUEMENT
#     par les migrations Prisma (prisma.config.ts). Propriétaire du schéma,
#     tous les droits de structure (CREATE/ALTER/DROP TABLE...).
DATABASE_URL=
MIGRATE_DATABASE_URL=

# ── Environnement ──
NODE_ENV=development
PORT=3000

# ── JWT (authentification admin) ──
# Générer des chaînes aléatoires longues et distinctes, ex : openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Front (CORS) ──
FRONTEND_URL=http://localhost:5173

# ── Service d'envoi d'emails (Resend) ──
# Récupérer la clé sur https://resend.com → API Keys
RESEND_API_KEY=

# ── Compte administrateur (seed) ──
ADMIN_PASSWORD=

# ── Destinataire des messages du formulaire de contact ──
CONTACT_EMAIL_TO=
